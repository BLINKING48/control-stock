<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Almacén Indirectos WRA</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      background-color: #111;
      color: #eee;
      margin: 20px;
    }

    h1, h2 {
      text-align: center;
      margin-bottom: 10px;
      color: #00ffcc;
    }

    .seccion-titulo {
      background-color: #222;
      padding: 20px;
      margin: 10px 0;
      border-radius: 12px;
      text-align: center;
      font-size: 24px;
      box-shadow: 0 0 10px #00ffcc;
    }

    .formulario-container, .busqueda-container, .tabla-container, .grafica-container, .footer-container {
      background-color: #1a1a1a;
      padding: 20px;
      border-radius: 12px;
      margin-bottom: 20px;
      box-shadow: 0 0 12px #00ffcc55;
    }

    form, .busqueda-container, .footer-container {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
    }

    input, button {
      padding: 12px;
      border-radius: 8px;
      border: none;
      font-size: 16px;
    }

    input {
      background-color: #333;
      color: #eee;
      border: 1px solid #555;
    }

    button {
      background-color: #00ffcc;
      color: #000;
      cursor: pointer;
      font-weight: bold;
    }

    button:hover {
      background-color: #00bfa5;
    }

    .explicacion {
      background-color: #a0ffc4;
      color: #000;
      padding: 8px 12px;
      margin: 5px;
      border-radius: 6px;
      font-size: 14px;
      display: inline-block;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      color: #fff;
      margin-top: 10px;
    }

    th, td {
      border: 1px solid #444;
      padding: 10px;
      text-align: center;
    }

    .alerta {
      color: #ff4d4d;
      font-weight: bold;
    }

    canvas {
      background-color: #fff;
      border-radius: 12px;
      padding: 10px;
    }

    .borrar {
      background-color: #ff4d4d;
      color: white;
    }
  </style>
</head>
<body>
  <div class="seccion-titulo">ALMACEN INDIRECTOS WRA</div>
  <div class="seccion-titulo">INVENTARIO</div>

  <div class="formulario-container">
    <span class="explicacion">ESTE ES PARA SUBIR NUEVOS NUMEROS DE PARTE</span><br />
    <form id="formulario">
      <input type="text" id="parte" placeholder="Número de Parte" required />
      <input type="number" id="cantidad" placeholder="Cantidad Actual" required />
      <input type="number" id="minimo" placeholder="Stock Mínimo" required />
      <input type="number" id="maximo" placeholder="Stock Máximo" required />
      <button type="submit">Guardar</button>
      <button type="button" id="btnActualizar">Actualizar</button>
    </form>
    <span class="explicacion">ESTE ES PARA ACTUALIZAR SU CANTIDAD DIARIA</span>
  </div>

  <div class="busqueda-container">
    <input type="text" id="busqueda" placeholder="Buscar Número de Parte" />
    <button type="button" id="btnBuscar">Buscar</button>
  </div>
  <div id="alertas" class="explicacion"></div>

  <div class="tabla-container">
    <table id="tablaStock">
      <thead>
        <tr>
          <th>Número de Parte</th>
          <th>Cantidad</th>
          <th>Mínimo</th>
          <th>Máximo</th>
          <th>Estado</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
  </div>

  <div class="grafica-container">
    <h2>Gráfica de Inventario</h2>
    <canvas id="graficoStock" width="600" height="300"></canvas>
  </div>

  <div class="footer-container">
    <span class="explicacion">ESTE ES PARA BUSCAR POR FECHA TODO LO QUE SE ACTUALIZÓ</span>
    <input type="date" />
    <button>Buscar</button>
    <span class="explicacion">AQUI ME MUESTRE TODO LO QUE SE SUBIÓ ESE DÍA DE NÚMEROS Y GRÁFICOS</span>
    <button>EXPORTAR A SHEET</button>
  </div>

  <script>
    const form = document.getElementById('formulario');
    const tabla = document.querySelector('#tablaStock tbody');
    const alertasDiv = document.getElementById('alertas');
    const graficoCanvas = document.getElementById('graficoStock').getContext('2d');
    const btnActualizar = document.getElementById('btnActualizar');
    const inputBusqueda = document.getElementById('busqueda');
    const btnBuscar = document.getElementById('btnBuscar');

    let datosMaterial = [];

    const chart = new Chart(graficoCanvas, {
      type: 'bar',
      data: {
        labels: [],
        datasets: [{
          label: 'Cantidad',
          backgroundColor: '#00ffcc',
          borderColor: '#00bfa5',
          borderWidth: 1,
          data: []
        }]
      },
      options: {
        plugins: {
          legend: { labels: { color: '#000' } }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: { color: '#000' }
          },
          x: {
            ticks: { color: '#000' }
          }
        }
      }
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const parte = document.getElementById('parte').value;
      const cantidad = parseInt(document.getElementById('cantidad').value);
      const minimo = parseInt(document.getElementById('minimo').value);
      const maximo = parseInt(document.getElementById('maximo').value);

      if (datosMaterial.find(item => item.parte === parte)) {
        alert("Ya existe ese número de parte. Usa 'Actualizar' para cambiar los datos.");
        return;
      }

      const estado = cantidad < minimo ? '⚠️ Stock bajo' : '✅ OK';
      if (cantidad < minimo) {
        alertasDiv.innerHTML = `<p class="alerta alerta-${parte}">Alerta: El stock de <strong>${parte}</strong> está por debajo del mínimo (${cantidad} < ${minimo})</p>`;
      }

      datosMaterial.push({ parte, cantidad, minimo, maximo, estado });
      agregarFilaATabla(parte, cantidad, minimo, maximo, estado);
      actualizarGrafico();
      form.reset();
    });

    btnActualizar.addEventListener('click', () => {
      const parte = document.getElementById('parte').value;
      const cantidad = parseInt(document.getElementById('cantidad').value);
      const minimo = parseInt(document.getElementById('minimo').value);
      const maximo = parseInt(document.getElementById('maximo').value);

      const index = datosMaterial.findIndex(item => item.parte === parte);
      if (index === -1) {
        alert("Número de parte no encontrado.");
        return;
      }

      const estado = cantidad < minimo ? '⚠️ Stock bajo' : '✅ OK';
      datosMaterial[index] = { parte, cantidad, minimo, maximo, estado };

      const alertaExistente = document.querySelector(`.alerta-${parte}`);
      if (alertaExistente) alertaExistente.remove();

      if (cantidad < minimo) {
        alertasDiv.innerHTML = `<p class="alerta alerta-${parte}">Alerta: El stock de <strong>${parte}</strong> está por debajo del mínimo (${cantidad} < ${minimo})</p>`;
      }

      actualizarTabla();
      actualizarGrafico();
      form.reset();
    });

    btnBuscar.addEventListener('click', () => {
      const filtro = inputBusqueda.value.trim();
      const resultado = datosMaterial.find(item => item.parte === filtro);

      if (!resultado) {
        alert("Número de parte no encontrado.");
        return;
      }

      alertasDiv.innerHTML = resultado.estado.includes('⚠️') ?
        `<p class="alerta alerta-${resultado.parte}">Alerta: El stock de <strong>${resultado.parte}</strong> está por debajo del mínimo (${resultado.cantidad} < ${resultado.minimo})</p>` :
        `<p><strong>${resultado.parte}</strong> tiene stock suficiente: ${resultado.cantidad}</p>`;

      chart.data.labels = [resultado.parte];
      chart.data.datasets[0].data = [resultado.cantidad];
      chart.update();
    });

    function agregarFilaATabla(parte, cantidad, minimo, maximo, estado) {
      const fila = tabla.insertRow();
      fila.insertCell(0).textContent = parte;
      fila.insertCell(1).textContent = cantidad;
      fila.insertCell(2).textContent = minimo;
      fila.insertCell(3).textContent = maximo;
      fila.insertCell(4).textContent = estado;

      const celdaBorrar = fila.insertCell(5);
      const btnBorrar = document.createElement('button');
      btnBorrar.textContent = 'Borrar';
      btnBorrar.className = 'borrar';
      btnBorrar.onclick = () => borrarParte(parte);
      celdaBorrar.appendChild(btnBorrar);
    }

    function actualizarTabla() {
      tabla.innerHTML = "";
      datosMaterial.forEach(({ parte, cantidad, minimo, maximo, estado }) => {
        agregarFilaATabla(parte, cantidad, minimo, maximo, estado);
      });
    }

    function actualizarGrafico() {
      chart.data.labels = datosMaterial.map(item => item.parte);
      chart.data.datasets[0].data = datosMaterial.map(item => item.cantidad);
      chart.update();
    }

    function borrarParte(parte) {
      if (!confirm(`¿Estás seguro de que quieres borrar el número de parte "${parte}"?`)) return;

      datosMaterial = datosMaterial.filter(item => item.parte !== parte);

      const alerta = document.querySelector(`.alerta-${parte}`);
      if (alerta) alerta.remove();

      actualizarTabla();
      actualizarGrafico();
    }
  </script>
</body>
</html>
